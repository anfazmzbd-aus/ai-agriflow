# Optional. Without this URL, the assistant returns an explicit offline/demo response.
AGRIFLOW_API_BASE_URL=http://127.0.0.1:8000
# Optional service credential; only used server-side. Set only if backend supports bearer auth.
AGRIFLOW_API_TOKEN=
# Configurable upstream endpoint matching the backend API contract.
AGRIFLOW_CHAT_PATH=/api/v1/chat
